                                                                       "exec":  [
                                                                                    "pm.test(\u0027Status ist 200\u0027, function () {",
                                                                                    "    pm.response.to.have.status(200);",
                                                                                    "});",
                                                                                    "",
                                                                                    "pm.test(\u0027Antwort ist ein Array\u0027, function () {",
                                                                                    "    pm.expect(pm.response.json()).to.be.an(\u0027array\u0027);",
                                                                                    "});",
                                                                                    "",
                                                                                    "pm.test(\u0027Teams enthalten die richtigen Felder\u0027, function () {",
                                                                                    "    pm.response.json().forEach(team =\u003e {",
                                                                                    "        pm.expect(team).to.have.property(\u0027id\u0027);",
                                                                                    "        pm.expect(team).to.have.property(\u0027name\u0027);",
                                                                                    "        pm.expect(team).to.have.property(\u0027klasse\u0027);",

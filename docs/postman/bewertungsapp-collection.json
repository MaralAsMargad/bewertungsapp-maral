                                                                                    "pm.test(\u0027Antwort ist ein Array\u0027, () =\u003e pm.expect(pm.response.json()).to.be.an(\u0027array\u0027));",
                                                                                    "pm.test(\u0027Bewertungen enthalten Score\u0027, () =\u003e {",
                                                                                    "    pm.response.json().forEach(e =\u003e pm.expect(e).to.have.property(\u0027score\u0027));",

                                                                                    "pm.test(\u0027Korrekte Fehlermeldung\u0027, () =\u003e {",
                                                                                    "    pm.expect(pm.response.json().error).to.eql(\u0027Projekt nicht gefunden\u0027);",
                                                                                    "});"
                                                                                ],

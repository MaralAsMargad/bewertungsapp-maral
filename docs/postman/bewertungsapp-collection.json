                 {
                     "name":  "04 - Auswertung",
                     "item":  [
                                  {
                                      "request":  {
                                                      "method":  "GET",
                                                      "url":  "{{baseUrl}}/project/9/statistik"
                                                  },
                                      "name":  "GET - Projektstatistik",
                                      "event":  [
                                                    {
                                                        "script":  {
                                                                       "exec":  [
                                                                                    "pm.test(\u0027Status ist 200\u0027, () =\u003e pm.response.to.have.status(200));",
                                                                                    "const statistik = pm.response.json();",
                                                                                    "pm.test(\u0027Antwort ist ein Array\u0027, () =\u003e pm.expect(statistik).to.be.an(\u0027array\u0027));",
                                                                                    "pm.test(\u0027Drei Kriterien vorhanden\u0027, () =\u003e pm.expect(statistik).to.have.lengthOf(3));",
                                                                                    "pm.test(\u0027Durchschnittswerte stimmen\u0027, () =\u003e {",
                                                                                    "    const werte = Object.fromEntries(statistik.map(e =\u003e [e.criterionId, Number(e.durchschnittsScore)]));",
                                                                                    "    pm.expect(werte[10]).to.eql(8);",
                                                                                    "    pm.expect(werte[11]).to.eql(7);",
                                                                                    "    pm.expect(werte[12]).to.eql(8);",
                                                                                    "});",
                                                                                    "pm.test(\u0027Gewichtungen vorhanden\u0027, () =\u003e {",
                                                                                    "    statistik.forEach(e =\u003e {",
                                                                                    "        pm.expect(e.Criterion).to.have.property(\u0027Weight\u0027);",
                                                                                    "    });",
                                                                                    "});"
                                                                                ],
                                                                       "type":  "text/javascript"
                                                                   },
                                                        "listen":  "test"
                                                    }
                                                ]
                                  },
